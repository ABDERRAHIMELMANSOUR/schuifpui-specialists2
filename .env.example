# Supabase-koppeling voor het reviewformulier.
#
# Beide waarden vind je in Supabase → Project Settings → Data API.
# De anon-key is bedoeld om publiek te zijn: hij staat in de JavaScript-bundle
# en wordt afgeschermd door de Row Level Security-policies uit
# supabase/schema.sql. Zet hier NOOIT de service_role-key neer.
#
# Lokaal: kopieer dit bestand naar `.env` en vul de waarden in.
# Vercel: zet dezelfde twee variabelen onder Settings → Environment Variables
#         (voor Production, Preview én Development) en deploy opnieuw.
#
# Ontbreken deze variabelen, dan blijft het reviewformulier gewoon werken:
# de review wordt dan alleen lokaal in de browser van de bezoeker bewaard.

VITE_SUPABASE_URL="https://jouw-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
